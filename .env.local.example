# Gemini (server-side only — never expose with NEXT_PUBLIC_)
GEMINI_API_KEY=

# Firebase (client SDK config — safe to expose)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-side only — used by `npm run seed`)
# Either set these three from your service account JSON...
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# ...or point this at the downloaded service account file instead:
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Uncomment to seed the local emulators rather than the live project:
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

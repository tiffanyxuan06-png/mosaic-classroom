# Gemini (server-side only — never expose with NEXT_PUBLIC_)
GEMINI_API_KEY=

# Supabase (client config — safe to expose)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (server-side only — used by API routes and
# `npm run seed`; never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
